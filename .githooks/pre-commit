#!/bin/sh
# 1. Bloqueia commits diretos em branches protegidas.
#    Branches: `git config hooks.protectedBranches "main master"` (padrão: main master).
#    Bypass consciente: ALLOW_MAIN=1 git commit ...
# 2. Higiene do conteúdo staged: marcadores de conflito e arquivos novos acima de
#    `git config hooks.maxFileKB` (padrão 500; arquivos Git LFS ignorados).
# 3. Segredos: gitleaks nas mudanças staged.
# Bypass de tudo: git commit --no-verify

if [ "${ALLOW_MAIN:-}" != "1" ]; then
  branch=$(git symbolic-ref --short -q HEAD)   # vazio em detached HEAD: deixa passar
  protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
  [ -n "$protected" ] || protected="main master"
  for p in $protected; do
    if [ -n "$branch" ] && [ "$branch" = "$p" ]; then
      {
        echo "✖ Commit direto na branch protegida '$branch' bloqueado."
        echo "  Crie uma branch de trabalho:  git switch -c feat/<nome>"
        echo "  Para forçar conscientemente:  ALLOW_MAIN=1 git commit ..."
      } >&2
      exit 1
    fi
  done
fi

check_merge_conflict() {
  hits=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep -nE '^\+(<{7}|>{7})( |$)' | head -5)
  [ -z "$hits" ] && return 0
  echo "✖ Marcadores de conflito não resolvidos nas mudanças staged:" >&2
  printf '%s\n' "$hits" | sed 's/^/   /' >&2
  return 1
}

check_added_large_files() {
  max_kb=$(git config --get hooks.maxFileKB); max_kb=${max_kb:-500}
  big=$(git diff --cached --name-only --diff-filter=A -z | xargs -0 -I{} sh -c '
    [ "$(git check-attr filter -- "$1" | sed "s/.*: //")" = lfs ] && exit 0
    kb=$(( ($(git cat-file -s ":$1") + 1023) / 1024 ))
    [ "$kb" -gt "$2" ] && echo "$1 (${kb} KB)"
    exit 0' sh {} "$max_kb")
  [ -z "$big" ] && return 0
  {
    echo "✖ Arquivos novos acima de ${max_kb} KB (git config hooks.maxFileKB):"
    printf '%s\n' "$big" | sed 's/^/   /'
    echo "  Use Git LFS, ou aumente o limite se eles devem ir para o git."
  } >&2
  return 1
}

check_secrets() {
  if ! command -v gitleaks >/dev/null 2>&1; then
    {
      echo "✖ gitleaks não encontrado (scanner de segredos do pre-commit)."
      echo "  Instale: https://github.com/gitleaks/gitleaks#installing (ex.: pacman -S gitleaks, brew install gitleaks)"
    } >&2
    return 1
  fi
  gitleaks git --staged --redact --no-banner --log-level warn
}

check_merge_conflict || exit 1
check_added_large_files || exit 1
check_secrets || exit 1
exit 0
