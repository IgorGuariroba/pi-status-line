#!/bin/sh
# 1. Bloqueia push (inclusive delete e refspec src:main) para branches protegidas.
#    Branches: `git config hooks.protectedBranches "main master"` (padrão: main master).
#    Bypass consciente: ALLOW_MAIN=1 git push ...
# 2. Roda os testes (o mesmo `npm test` do CI).
# Bypass de tudo: git push --no-verify

remote_name="$1"

protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
[ -n "$protected" ] || protected="main master"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  for p in $protected; do
    if [ "$remote_ref" = "refs/heads/$p" ]; then
      [ "${ALLOW_MAIN:-}" = "1" ] && continue
      {
        echo "✖ Push para a branch protegida '$p' em '$remote_name' bloqueado (origem: $local_ref)."
        echo "  Publique numa branch de trabalho:  git switch -c feat/<nome> && git push -u $remote_name feat/<nome>"
        echo "  Para forçar conscientemente:       ALLOW_MAIN=1 git push ..."
      } >&2
      status=1
    fi
  done
done
[ "$status" -eq 0 ] || exit "$status"

cd "$(git rev-parse --show-toplevel)" || exit 1
[ -f package.json ] || exit 0
npm test --silent || {
  echo "✖ Testes falharam; push bloqueado (bypass: git push --no-verify)." >&2
  exit 1
}
exit 0
