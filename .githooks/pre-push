#!/bin/sh
# Bloqueia push (inclusive delete e refspec src:main) para branches protegidas.
# Branches: `git config hooks.protectedBranches "main master"` (padrão: main master).
# Bypass consciente: ALLOW_MAIN=1 git push ...   (ou git push --no-verify)

remote_name="$1"

protected=$(git config --get hooks.protectedBranches)
[ -n "$protected" ] || protected="main master"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  for p in $protected; do
    if [ "$remote_ref" = "refs/heads/$p" ]; then
      [ "${ALLOW_MAIN:-}" = "1" ] && continue
      {
        echo "✖ Push para a branch protegida '$p' em '$remote_name' bloqueado (origem: $local_ref)."
        echo "  Publique numa branch de trabalho:  git switch -c feat/<nome> && git push -u $remote_name feat/<nome>"
        echo "  Para forçar conscientemente:       ALLOW_MAIN=1 git push ..."
      } >&2
      status=1
    fi
  done
done
exit $status
